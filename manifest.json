{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Chrome Update Notifier",
  "version": "1.0",
  "description": "4週リリース周期を予測し、必要な時だけ確認してChromeの更新を通知",
  "permissions": ["alarms", "notifications", "storage", "management"],
  "host_permissions": ["https://versionhistory.googleapis.com/*", "https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "今すぐ更新チェック",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
